+/* Return closest neighbors for specific IDs only */
+template <class HammingComputer>
+void hammings_knn_hc_with_ids(
+        int bytes_per_code,
+        int_maxheap_array_t* __restrict ha,
+        const uint8_t* __restrict bs1,
+        const uint8_t* __restrict bs2,
+        const int64_t* __restrict ids,
+        size_t n_ids,
+        bool order = true,
+        bool init_heap = true) {
+    size_t k = ha->k;
+    if (init_heap) {
+        ha->heapify();
+    }
+    //print log statement
+    HammingComputer hc(bs1, bytes_per_code);
+    hamdis_t* __restrict bh_val_ = ha->val;
+    int64_t* __restrict bh_ids_ = ha->ids;
+
+#pragma omp parallel for
+    for (size_t idx = 0; idx < n_ids; idx++) {
+        int64_t j = ids[idx];
+        const uint8_t* bs2_ = bs2 + j * bytes_per_code;
+        hamdis_t dis = hc.hamming(bs2_);
+        if (dis < bh_val_[0]) {
+#pragma omp critical
+            {
+                if (dis < bh_val_[0]) {
+                    faiss::maxheap_replace_top<hamdis_t>(k, bh_val_, bh_ids_, dis, j);
+                }
+            }
+        }
+    }
+    
+    if (order) {
+        ha->reorder();
+    }
+}
