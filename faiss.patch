+void IndexBinaryHNSW::exact_search(
+        idx_t n,
+        const uint8_t* x,
+        idx_t k,
+        int32_t* distances,
+        idx_t* labels,
+        const idx_t* internal_ids,
+        idx_t n_internal_ids) const {
+    FAISS_THROW_IF_NOT(k > 0);
+    FAISS_THROW_IF_NOT(internal_ids != nullptr);
+    FAISS_THROW_IF_NOT(n_internal_ids > 0);
+
+#pragma omp parallel for
+    for (idx_t i = 0; i < n; i++) {
+        std::unique_ptr<DistanceComputer> dis(get_distance_computer());
+        dis->set_query((float*)(x + i * code_size));
+        
+        std::vector<std::pair<float, idx_t>> results;
+        results.reserve(n_internal_ids);
+        
+        for (idx_t j = 0; j < n_internal_ids; j++) {
+            idx_t internal_id = internal_ids[j];
+            if (internal_id >= 0 && internal_id < ntotal) {
+                results.emplace_back((*dis)(internal_id), internal_id);
+            }
+        }
+        
+        idx_t result_k = std::min(k, (idx_t)results.size());
+        std::partial_sort(results.begin(), results.begin() + result_k, results.end());
+        
+        for (idx_t j = 0; j < result_k; j++) {
+            distances[i * k + j] = (int32_t)std::round(results[j].first);
+            labels[i * k + j] = results[j].second;
+        }
+        
+        for (idx_t j = result_k; j < k; j++) {
+            distances[i * k + j] = std::numeric_limits<int32_t>::max();
+            labels[i * k + j] = -1;
+        }
+    }
+}
