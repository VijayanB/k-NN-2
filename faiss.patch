+/* Return closest neighbors for specific IDs only, using max count. */
+template <class HammingComputer>
+void hammings_knn_mc_with_ids(
+        int bytes_per_code,
+        const uint8_t* __restrict a,
+        const uint8_t* __restrict b,
+        size_t na,
+        const int64_t* __restrict ids,
+        size_t n_ids,
+        size_t k,
+        int32_t* __restrict distances,
+        int64_t* __restrict labels) {
+    const int nBuckets = bytes_per_code * 8 + 1;
+    std::vector<int> all_counters(na * nBuckets, 0);
+    std::unique_ptr<int64_t[]> all_ids_per_dis(new int64_t[na * nBuckets * k]);
+
+    std::vector<HCounterState<HammingComputer>> cs;
+    //print using cout
+    std::cout << "na" << na << std::endl;
+    // print all_counters.data()
+    std::cout << "all_counters.data()" << all_counters.data() << std::endl;
+    for (size_t i = 0; i < na; ++i) {
+        cs.push_back(HCounterState<HammingComputer>(
+                all_counters.data() + i * nBuckets,
+                all_ids_per_dis.get() + i * nBuckets * k,
+                a + i * bytes_per_code,
+                8 * bytes_per_code,
+                k));
+    }
+
+#pragma omp parallel for
+    for (int64_t i = 0; i < na; ++i) {
+        for (size_t idx = 0; idx < n_ids; ++idx) {
+            int64_t j = ids[idx];
+            cs[i].update_counter(b + j * bytes_per_code, j);
+        }
+    }
+
+    for (size_t i = 0; i < na; ++i) {
+        HCounterState<HammingComputer>& csi = cs[i];
+
+        int nres = 0;
+        for (int b_2 = 0; b_2 < nBuckets && nres < k; b_2++) {
+            for (int l = 0; l < csi.counters[b_2] && nres < k; l++) {
+                labels[i * k + nres] = csi.ids_per_dis[b_2 * k + l];
+                distances[i * k + nres] = b_2;
+                nres++;
+            }
+        }
+        while (nres < k) {
+            labels[i * k + nres] = -1;
+            distances[i * k + nres] = std::numeric_limits<int32_t>::max();
+            ++nres;
+        }
+    }
+}
